  "captions": [
    {
      "from": 0,
      "to": 6,
      "text": "قبل ما تطلب… بص واسأل"
    },
    {
      "from": 6,
      "to": 15,
      "text": "إيه المعلومات عن حالة الحيوان؟"
    },
    {
      "from": 15,
      "to": 21,
      "text": "الوزن هيتوضح إزاي؟"
    },
    {
      "from": 21,
      "to": 27,
      "text": "قائم ولا بعد التجهيز؟"
    },
    {
      "from": 27,
      "to": 35,
      "text": "أنهي قطعة تناسب أكلتك؟"
    },
    {
      "from": 35,
      "to": 43,
      "text": "إيه التقطيع والتعبئة المتاحين؟"
    },
    {
      "from": 43,
      "to": 48,
      "text": "الكمية والسعر والميعاد؟"
    },
    {
      "from": 48,
      "to": 52,
      "text": "التوصيل متاح؟ وتفاصيله إيه؟"
    }
  ],
