{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "terranex://creative-plan.schema.json",
  "title": "Creative Director — Arena-authored creative plan",
  "type": "object",
  "required": ["schema_version", "hook", "shots"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "topic": {"enum": ["field-followup", "feeding", "weight"]},
    "note": {"type": "string", "maxLength": 1000},
    "hook": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 120},
        "duration_sec": {"type": "number", "minimum": 0.2, "maximum": 5}
      }
    },
    "endcard_sec": {"type": "number", "minimum": 0, "maximum": 10},
    "shots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["scene_id", "text", "duration_sec"],
        "additionalProperties": false,
        "properties": {
          "scene_id": {"type": "string", "pattern": "^s[0-9]{2}-[0-9]{2}$"},
          "role": {"type": "string", "maxLength": 60},
          "text": {"type": "string", "minLength": 1, "maxLength": 160},
          "motion": {"type": "string", "maxLength": 240},
          "duration_sec": {"type": "number", "minimum": 0.2, "maximum": 30},
          "weight": {"type": "number", "minimum": 0.1, "maximum": 10},
          "source_start": {"type": "number", "minimum": 0},
          "source_end": {"type": "number", "minimum": 0}
        }
      }
    },
    "voice_phrases": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["text"],
        "additionalProperties": false,
        "properties": {
          "role": {"type": "string"},
          "text": {"type": "string", "minLength": 1, "maxLength": 160}
        }
      }
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"text": {"type": "string", "maxLength": 160}}
    },
    "endcard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headline": {"type": "string", "maxLength": 80},
        "subtitle": {"type": "string", "maxLength": 80},
        "cta": {"type": "string", "maxLength": 80},
        "disclosure": {"type": "string", "maxLength": 120}
      }
    }
  }
}
