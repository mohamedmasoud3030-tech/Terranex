{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "terranex://revision.schema.json",
  "title": "Creative Director — structured revision patch",
  "type": "object",
  "required": ["schema_version", "operations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["op"],
        "properties": {
          "op": {"enum": ["replace_beginning", "promote_tag", "reduce_tag_duration", "set_hook"]},
          "tag": {"type": "string"},
          "position": {"type": "integer", "minimum": 0},
          "factor": {"type": "number", "minimum": 0.1, "maximum": 1},
          "target": {"enum": ["longest", "first"]},
          "text": {"type": "string"}
        }
      }
    }
  }
}
