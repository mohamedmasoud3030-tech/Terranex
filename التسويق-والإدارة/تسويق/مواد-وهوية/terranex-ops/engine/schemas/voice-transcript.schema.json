{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "terranex://voice-transcript.schema.json",
  "title": "Creative Director — approved spoken transcript manifest",
  "type": "object",
  "required": ["verification_method", "reviewer", "approval_note", "phrases"],
  "additionalProperties": false,
  "properties": {
    "verification_method": {"const": "human-reviewed"},
    "reviewer": {"type": "string", "minLength": 1},
    "approval_note": {"type": "string", "minLength": 1},
    "ai_generated": {"type": "boolean"},
    "phrases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text"],
        "additionalProperties": false,
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "from": {"type": "number", "minimum": 0},
          "to": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}
