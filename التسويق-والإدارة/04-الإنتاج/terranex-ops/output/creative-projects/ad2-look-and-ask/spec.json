  "captions": [
    {
      "from": 0.18,
      "to": 3.88,
      "text": "قبل ما تطلب… بص واسأل الأول"
    },
    {
      "from": 4.1,
      "to": 8.94,
      "text": "الحيوان اللي قدامك حالته ونشاطه إيه؟"
    },
    {
      "from": 9.14,
      "to": 12.26,
      "text": "إقباله على العلف ووقفته باينين قدامك؟"
    },
    {
      "from": 12.48,
      "to": 16.42,
      "text": "وفحص السن ورقم الأذن قبل الاختيار؟"
    },
    {
      "from": 16.64,
      "to": 21.56,
      "text": "الوزن بيتوضح إزاي وقت تحديد الطلب؟"
    },
    {
      "from": 21.78,
      "to": 27.1,
      "text": "اطلب توضيح طريقة تسجيل وزن طلبك"
    },
    {
      "from": 27.32,
      "to": 30.72,
      "text": "نقطة بتفرّق كتير قبل أي اتفاق"
    },
    {
      "from": 30.92,
      "to": 34.48,
      "text": "المعروض وزن قائم ولا لحمة مجهزة؟"
    },
    {
      "from": 34.7,
      "to": 38.28,
      "text": "إيه قطعيات الضاني البرقي المتاحة؟"
    },
    {
      "from": 38.48,
      "to": 41.94,
      "text": "وأنسب قطعية لصواني الفرن والطواجن إيه؟"
    },
    {
      "from": 42.15,
      "to": 44.98,
      "text": "والطلب بيتقسم ويتعبأ بأي شكل؟"
    },
    {
      "from": 45.18,
      "to": 49.86,
      "text": "وقبل الاستلام أو التوصيل تأكد إيه؟"
    },
    {
      "from": 50.08,
      "to": 55.35,
      "text": "راجع الميعاد وطريقة التسليم ومواصفات طلبك"
    },
    {
      "from": 55.58,
      "to": 59.25,
      "text": "اسأل وحدد طلبك على بيّنة"
    }
  ],
