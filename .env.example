VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# --- Odoo accounting backend (optional) -----------------------------
# Set VITE_ODOO_ENABLED=true to turn on Terranex → Odoo sync.
# See external/odoo/README.md for how to run Odoo in Docker.
VITE_ODOO_ENABLED=false
VITE_ODOO_URL=http://localhost:8069
VITE_ODOO_DB=terranex
VITE_ODOO_USERNAME=admin
VITE_ODOO_API_KEY=your-odoo-api-key
