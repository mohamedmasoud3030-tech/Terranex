VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# --- Odoo 18 accounting backend (Egypt-first, server-side only) -------------
# Do not prefix any Odoo credential with VITE_. The browser invokes the
# `odoo-sync` Supabase Edge Function; only that function can read these secrets.
# Odoo credentials are set-on-server-only through Supabase Function secrets.
#
# Configure them with:
# supabase secrets set \
#   ODOO_URL=https://odoo.example.com \
#   ODOO_DB=terranex_egypt \
#   ODOO_USERNAME=integration@company.com \
#   ODOO_API_KEY=replace-with-odoo-api-key \
#   ODOO_COMPANY_ID=1 \
#   ODOO_ANALYTIC_PLAN_ID=1
#
# Required Odoo modules for the first Egyptian deployment:
#   l10n_eg           Egypt accounting localization
#   account           accounting / customer invoices / vendor bills
# Optional later (ETA production onboarding):
#   l10n_eg_edi_eta   Egyptian Tax Authority e-invoicing integration
