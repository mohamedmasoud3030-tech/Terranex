VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# --- Odoo accounting backend (optional) -----------------------------
# Terranex ⇄ Odoo sync is performed server-side (Edge Function) so the
# Odoo API key is NEVER bundled into the browser. The frontend only stores
# non-secret connection metadata in company_settings (url/db/username/enabled).
# Set the ODOO_API_KEY secret in your Supabase project's vault / Edge Function
# environment — do NOT add it here or prefix it with VITE_.
VITE_ODOO_ENABLED=false
VITE_ODOO_URL=http://localhost:8069
VITE_ODOO_DB=terranex
VITE_ODOO_USERNAME=admin
# ODOO_API_KEY=set-on-server-only  (never expose to browser)
