# -------------------------------------------------------------------
# Odoo docker-compose environment
# Copy to .env and set real passwords before running `docker compose up -d`
# -------------------------------------------------------------------

# Database password for the odoo Postgres user (use a long random string).
ODOO_DB_PASSWORD=CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD

# Odoo master password (used to create/delete databases from the web UI).
ODOO_MASTER_PASSWORD=CHANGE_ME_TO_A_STRONG_MASTER_PASSWORD
